# --- Lovable Cloud / Supabase (database, storage) ---
# Client-visible
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=<project-ref>
# Server-only (never expose to the browser)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- Steel.dev cloud browser (real recording engine) ---
STEEL_API_KEY=

# --- AI (scene planning / narration). Lovable AI Gateway key, or swap for your own provider ---
LOVABLE_API_KEY=

# --- Optional: Firecrawl for richer site maps ---
FIRECRAWL_API_KEY=

# --- AES-256-GCM key used to encrypt stored product credentials (64 chars) ---
DEMOFORGE_CREDS_KEY=

# --- Appwrite TablesDB + Storage (server-only; never expose to the browser) ---
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=wisedemo
APPWRITE_PROJECTS_COLLECTION_ID=projects
APPWRITE_CREDENTIALS_COLLECTION_ID=project_credentials
APPWRITE_DEMOS_COLLECTION_ID=demos
APPWRITE_DEMO_EVENTS_COLLECTION_ID=demo_events
APPWRITE_COMPOSITIONS_COLLECTION_ID=compositions
APPWRITE_COMPOSITION_EXPORTS_COLLECTION_ID=composition_exports
APPWRITE_RECORDINGS_BUCKET_ID=demo-recordings

# Bootstrap only: use a temporary setup key, run npm run appwrite:bootstrap,
# then revoke the key and remove this value. Never use the runtime key here.
APPWRITE_SETUP_API_KEY=

# --- Steel.dev cloud browser (real recording engine) ---
STEEL_API_KEY=

# --- AI (scene planning / narration). Lovable AI Gateway key, or swap for your own provider ---
LOVABLE_API_KEY=

# --- Optional: Firecrawl for richer site maps ---
FIRECRAWL_API_KEY=

# --- AES-256-GCM key used to encrypt stored product credentials (64 chars) ---
WISEDEMO_CREDS_KEY=
